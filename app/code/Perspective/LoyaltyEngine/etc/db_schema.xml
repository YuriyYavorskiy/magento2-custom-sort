<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="loyalty_transactions" resource="default" engine="innodb" comment="Loyalty Immutable Transactions Ledger">
        <column xsi:type="int" name="transaction_id" unsigned="true" nullable="false" identity="true"
                comment="Transaction ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" identity="false"
                comment="Customer ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="true" identity="false"
                comment="Order ID"/>
        <column xsi:type="decimal" name="points" scale="4" precision="12" nullable="false" default="0.0000"
                comment="Points Delta"/>
        <column xsi:type="varchar" name="type" length="32" nullable="false"
                comment="Transaction Type: accrual, redemption, adjustment"/>
        <column xsi:type="varchar" name="comment" length="255" nullable="true"
                comment="Transaction Comment"/>
        <column xsi:type="varchar" name="reference_key" length="64" nullable="true"
                comment="Idempotency key, e.g. accrual:ORDER_ID"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="transaction_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="LOYALTY_TRANSACTIONS_REFERENCE_KEY">
            <column name="reference_key"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="FK_LOYALTY_TRANSACTIONS_CUSTOMER_ID"
                    table="loyalty_transactions" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id"
                    onDelete="CASCADE"/>

        <index referenceId="IDX_LOYALTY_TRANSACTIONS_CUSTOMER_CREATED" indexType="btree">
            <column name="customer_id"/>
            <column name="created_at"/>
        </index>
        <index referenceId="IDX_LOYALTY_TRANSACTIONS_ORDER_TYPE" indexType="btree">
            <column name="order_id"/>
            <column name="type"/>
        </index>
    </table>

    <table name="loyalty_balance_index" resource="default" engine="innodb" comment="Loyalty Active Balance Flat Index Table">
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" identity="false"
                comment="Customer ID"/>
        <column xsi:type="decimal" name="total_active_points" scale="4" precision="12" nullable="false" default="0.0000"
                comment="Total Active Points"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Updated At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="customer_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="FK_LOYALTY_BALANCE_INDEX_CUSTOMER_ID"
                    table="loyalty_balance_index" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
    </table>

    <table name="quote" resource="checkout" engine="innodb">
        <column xsi:type="decimal" name="loyalty_points_applied" scale="4" precision="12" nullable="false" default="0.0000"
                comment="Loyalty Points Applied"/>
        <column xsi:type="decimal" name="loyalty_discount_amount" scale="4" precision="12" nullable="false" default="0.0000"
                comment="Loyalty Discount Amount"/>
        <column xsi:type="decimal" name="base_loyalty_discount_amount" scale="4" precision="12" nullable="false" default="0.0000"
                comment="Base Loyalty Discount Amount"/>
    </table>

    <table name="sales_order" resource="sales" engine="innodb">
        <column xsi:type="decimal" name="loyalty_points_applied" scale="4" precision="12" nullable="false" default="0.0000"
                comment="Loyalty Points Applied"/>
        <column xsi:type="decimal" name="loyalty_discount_amount" scale="4" precision="12" nullable="false" default="0.0000"
                comment="Loyalty Discount Amount"/>
        <column xsi:type="decimal" name="base_loyalty_discount_amount" scale="4" precision="12" nullable="false" default="0.0000"
                comment="Base Loyalty Discount Amount"/>
    </table>

    <table name="sales_invoice" resource="sales" engine="innodb">
        <column xsi:type="decimal" name="loyalty_discount_amount" scale="4" precision="12" nullable="false"
                default="0.0000" comment="Loyalty Discount Amount"/>
        <column xsi:type="decimal" name="base_loyalty_discount_amount" scale="4" precision="12" nullable="false"
                default="0.0000" comment="Base Loyalty Discount Amount"/>
    </table>

    <table name="sales_creditmemo" resource="sales" engine="innodb">
        <column xsi:type="decimal" name="loyalty_discount_amount" scale="4" precision="12" nullable="false"
                default="0.0000" comment="Loyalty Discount Amount"/>
        <column xsi:type="decimal" name="base_loyalty_discount_amount" scale="4" precision="12" nullable="false"
                default="0.0000" comment="Base Loyalty Discount Amount"/>
    </table>
</schema>
