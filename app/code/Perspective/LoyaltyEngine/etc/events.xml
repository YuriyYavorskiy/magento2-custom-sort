<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_order_save_after">
        <observer name="perspective_loyalty_order_complete_accrual"
                  instance="Perspective\LoyaltyEngine\Observer\OrderCompleteAccrualObserver"/>
        <!-- Runs inside the order save transaction so redemption and order are committed atomically -->
        <observer name="perspective_loyalty_order_place_redemption"
                  instance="Perspective\LoyaltyEngine\Observer\OrderPlaceRedemptionObserver"/>
    </event>
    <event name="order_cancel_after">
        <observer name="perspective_loyalty_order_cancel_refund"
                  instance="Perspective\LoyaltyEngine\Observer\OrderCancelRefundObserver"/>
    </event>
    <event name="sales_order_creditmemo_save_after">
        <observer name="perspective_loyalty_creditmemo_refund"
                  instance="Perspective\LoyaltyEngine\Observer\CreditmemoRefundObserver"/>
    </event>
</config>
